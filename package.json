{
  "name": "ciphersqlstudio",
  "version": "2.0.0",
  "description": "SQL Learning Platform with AI-powered hints",
  "author": "Gourav Chaudhary",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "start": "tsx server/src/index.ts",
    "build": "npm run typecheck:server",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "typecheck": "npm run typecheck:server && npm --prefix client run typecheck",
    "typecheck:server": "tsc -p tsconfig.json",
    "install:all": "npm install && npm --prefix client install",
    "seed": "tsx server/src/scripts/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "openai": "^7.55.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
