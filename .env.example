# ================================
# CipherSQLStudio Environment Variables
# ================================
# Local development: copy this file to .env (repo root) and fill in your values.
# Vercel: add the same variables in Project → Settings → Environment Variables.

# Server port (local only)
PORT=5000

# MongoDB connection (required)
# Free cluster: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ciphersqlstudio

# PostgreSQL sandbox (required)
# Supabase (https://supabase.com) or Neon (https://neon.tech) both work.
# Either set a full connection string...
# POSTGRES_URL=postgres://user:password@host:5432/postgres
# ...or the individual parts:
POSTGRES_HOST=db.xxxxx.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
# SSL is on automatically except for localhost. Force it with true/false:
# POSTGRES_SSL=true

# JWT secret for authentication (required in production)
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# JWT_EXPIRES_IN=7d

# AI hints (optional - built-in hints are used when no key is set)
# Options: "openai" or "gemini"
LLM_PROVIDER=gemini

# Google Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI - get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# Comma-separated list of allowed browser origins (default: allow all)
# CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:3000

# Sandbox limits
MAX_QUERY_EXECUTION_TIME=5000
MAX_RESULT_ROWS=1000

NODE_ENV=development
